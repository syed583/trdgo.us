# US-Stock Reader -- configuration.
#
# Copy to .env and fill in. .env is git-ignored and must stay that way: it
# holds one subscription token, one model key and the password to the app.
#
#   cp backend/.env.example backend/.env
#
# Nothing here has a default that reaches a provider. An unset key means that
# provider is skipped and the screens it powers say so, which is the intended
# behaviour rather than a failure.

# --- the app ---------------------------------------------------------------

# The password to open the app. Leave empty to run without a login, which is
# only sane on a machine nobody else can reach.
ACCESS_PASSWORD=change-me

# Signs session cookies. Any long random string; changing it logs everyone
# out. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Postgres. The app creates its own tables on first run.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/usstocks

# --- the one paid feed -----------------------------------------------------

# Unusual Whales. Powers the options tape, market/stock/chain flow, bars and
# quotes, earnings, dividends, analysts, news, insiders, dark pool, the
# screener, fundamentals and short interest. One key, one person: their terms
# forbid redistributing the key, the data, or output derived from it.
UNUSUAL_WHALES_API_KEY=

# --- optional: the model that writes the explanations ----------------------

# Claude. Used only on demand, for the plain-English explanations. Without it
# those buttons say the provider is not configured; every number on every
# screen is unaffected, because Claude supplies words and never figures.
ANTHROPIC_API_KEY=

# --- optional: Interactive Brokers -----------------------------------------
#
# TWS or IB Gateway, for live quotes and intraday bars. There is normally no
# TWS on a server, and the app does not need one: Unusual Whales serves both.
#
# On a server, set IBKR_ENABLED=0. Left on, every call attempts a connection,
# is refused, logs two lines about opening the API port, and repeats a minute
# later for as long as the app runs. Off, the app stops asking and the
# Settings screen reports it as switched off rather than broken.
IBKR_ENABLED=1
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
IBKR_MARKET_DATA_TYPE=1

# --- optional: the free providers kept behind Unusual Whales ---------------
#
# Each is a fallback for one area. All of them can be left empty.
FINVIZ_AUTH_TOKEN=
BENZINGA_API_KEY=
MARKETAUX_API_TOKEN=
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Which news backend leads when Unusual Whales is not configured.
NEWS_PROVIDER=
